# Orbit Router Environment Variables

# Server (required)
PORT=3000
BASE_URL=http://localhost:3000

# Session (required - generate a random secret)
SESSION_SECRET=change-this-to-a-random-secret-string

# OAuth for Kiro AI (optional - get from kiro.ai developers)
KIRO_CLIENT_ID=
KIRO_CLIENT_SECRET=

# OAuth for ChatGPT/OpenAI (optional - get from platform.openai.com)
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=

# CORS
CORS_ORIGINS=*