# Keys issued to friends. Generate long random values beginning with rtr_.
ROUTER_API_KEYS=rtr_replace_with_a_long_random_value

# Advanced per-user format with rate limits and optional model restrictions:
# ROUTER_KEYS_JSON=[{"name":"friend","key":"rtr_long_random_value","rpm":30,"models":["orbit-auto","gpt-5.5"]}]

ADMIN_KEY=replace_with_a_different_long_random_value
FISHAPPEDU_API_KEY=
OPENROUTER_API_KEY=

# A local URL cannot work from Render. Set this only for a publicly reachable OmniRoute server.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=

CORS_ORIGINS=*
PORT=3000
